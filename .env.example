# 复制为 .env 并填写真实值。多个账号用 | 分隔。
# ALIYUN_USERS 单账号字段：name, ak, sk, region, instance_id, traffic_limit(G,默认180),
#                           resgroup(RAM资源组ID,可空), bill_endpoint, currency(¥/$)

# Telegram 通知（必填）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 控制机器人管理员（选填，留空则不启动控制机器人）
# 用逗号/空格分隔多个数字用户 ID。注意：是 Telegram 用户 ID（@userinfobot 可查），不是群组 Chat ID。
ADMIN_USERS=

# Bark 推送（选填）
BARK_URL=

# 被监控的阿里云账号/实例（必填）
# 国内站示例：
# ALIYUN_USERS='name=HK-Server,ak=LTAIxxx,sk=xxx,region=cn-hongkong,instance_id=i-xxx,traffic_limit=180'
# 多账号用 | 分隔；国际站账号加 currency=$：
# ALIYUN_USERS='name=HK,ak=..,sk=..,region=cn-hongkong,instance_id=i-a,traffic_limit=180 | name=SG,ak=..,sk=..,region=ap-southeast-1,instance_id=i-b,traffic_limit=100,currency=$'
ALIYUN_USERS=

# 是否强制用环境变量重建 config.json（覆盖挂载卷中的旧配置）。0=沿用挂载配置(默认) 1=重建
ALIYUN_MONITOR_FORCE_RECONFIG=0
